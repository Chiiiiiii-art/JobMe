# === 評分模型金鑰 (Jev 決策引擎) ===
# 方案 A (推薦免費): 使用 OpenCode API (模型 jev-1.13-free 免費額度)
OPENCODE_API_KEY=your_opencode_api_key_here

# 方案 B (推薦儲值): 使用 OpenRouter 聚合平台 (模型 typesafe/jev-latest)
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# 方案 C: 直接使用 TypeSafe 官方原生 API
# TYPESAFE_API_KEY=your_typesafe_api_key_here

# === DeepSeek 企業分級模型金鑰 ===
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# (選填) 自訂覆寫端點或模型 (預設為 https://api.deepseek.com 與 deepseek-flash)
# DEEPSEEK_API_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash

# (選填) 自訂覆寫 Jev 端點與模型名稱 (預設會依金鑰自動判斷)
# JEV_API_URL=https://openrouter.ai/api/alpha/decisions
# JEV_MODEL=typesafe/jev-1.14

# === 通知推播 ===
# Discord 頻道 Webhook 網址 (在頻道設定 -> 整合 -> 建立 Webhook 複製)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# === 通用職缺分類 (跨平台通用，支援名稱或 104 代碼，逗號分隔，隨時可增修) ===
JOB_CATEGORIES=資訊軟體,專案管理,商業分析,數據分析

# === Discord 互動機器人控制台與頻道設定 (選填) ===
# DISCORD_BOT_TOKEN=your_bot_token_here
# DISCORD_CHANNEL_ID=your_panel_channel_id_here         # 中控台面板專屬頻道 (如 #panel)
# DISCORD_JOB_CHANNEL_ID=your_feed_channel_id_here      # 職缺推播專屬頻道 (如 #job-here，附帶收藏按鈕)
# DISCORD_FAVORITES_CHANNEL_ID=your_fav_channel_id_here # 收藏轉發專屬頻道 (如 #job-mine，附帶移除按鈕)


